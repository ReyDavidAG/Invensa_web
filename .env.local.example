# ====================================================================
# Invensa_web — variables de entorno (estructura)
# ====================================================================
# Copia este archivo a `.env.local` y rellena los valores reales.
# NUNCA commitees `.env.local` al repo (está en .gitignore).
# ====================================================================

# ---- Aplicación ----------------------------------------------------
# URL pública de tu deploy. En Vercel se inyecta solo vía process.env.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Locale de la app (es-MX para tu hermana y tu mamá)
NEXT_PUBLIC_LOCALE="es-MX"

# ---- Supabase ------------------------------------------------------
# 1) Crear proyecto en https://supabase.com (free tier)
# 2) Settings > API > copiar Project URL + anon public + service_role secret

# Pública — se usa en cliente (auth, RLS valida el JWT)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# PRIVADA — solo servidor (saltar RLS para jobs/invitaciones). JAMÁS al cliente.
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret>"

# Para validar webhooks firmados por Supabase (Settings > API > Webhook secret)
SUPABASE_WEBHOOK_SECRET=""

# ---- Cloudflare R2 (imágenes de productos) -------------------------
# 1) Crear cuenta en https://cloudflare.com (free tier)
# 2) R2 > Create bucket (nombre público, ej. invensa-products)
# 3) R2 > Manage R2 API Tokens > crear token con scope "Object Read & Write"
# 4) Account ID en Cloudflare dashboard > R2 > Account ID

# Público — URL del bucket para servir imágenes en el navegador
NEXT_PUBLIC_R2_PUBLIC_URL="https://<bucket>.<account-id>.r2.cloudflarestorage.com"

# PRIVADO — generar presigned URLs en el servidor
R2_ACCOUNT_ID="<cloudflare-account-id>"
R2_ACCESS_KEY_ID="<r2-access-key-id>"
R2_SECRET_ACCESS_KEY="<r2-secret-access-key>"
R2_BUCKET="invensa-products"
R2_REGION="auto"

# ---- Email transaccional (Gmail SMTP via nodemailer) -------------
# Gratis. Límite Gmail personal: 500 emails/día (Invensa usa ~2/día).
#
# Setup:
# 1) Crear "contraseña de aplicación" en Google:
#    https://myaccount.google.com/apppasswords
#    (necesitas 2FA activado en la cuenta)
# 2) Poner el Gmail y la contraseña de 16 chars aquí:
GMAIL_USER="invensa.tu@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
# 3) EMAIL_FROM es lo que aparece como remitente. Por defecto usa GMAIL_USER.
#    Opcional: "Invensa <invensa.tu@gmail.com>" para mostrar nombre.
EMAIL_FROM="Invensa <invensa.tu@gmail.com>"

# ---- AI / MiniMax (foto → producto) -------------------------------
# Tu API key de MiniMax (suscripción Max).
# Obtenerla en: https://platform.minimax.io → API Keys
#   - Pay-as-you-go: API Key desde "API Keys"
#   - Token Plan:    Subscription Key desde "Billing > Token Plan"
# Cualquiera de las dos funciona con esta integración.
MINIMAX_API_KEY=""
MINIMAX_MODEL="MiniMax-M3"

# ---- App URLs ------------------------------------------------------
APP_BASE_URL="http://localhost:3000"

# ====================================================================
# Notas de seguridad
# ====================================================================
# - NEXT_PUBLIC_* son visibles en el bundle del cliente. Solo pon ahí
#   valores seguros para exponer (URLs, claves públicas, locales).
# - Cualquier variable sin NEXT_PUBLIC_ es SOLO del servidor.
# - service-role key de Supabase = root de tu BD. Si se filtra,
#   rotala inmediatamente desde el dashboard de Supabase.
# - Rotar secretos cada 90 días en producción.
# ====================================================================
